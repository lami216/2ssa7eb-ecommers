# Frontend environment variables
VITE_STORE_WHATSAPP_NUMBER=22241380130
VITE_API_BASE_URL=/api
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Backend environment variables
FRONTEND_URL=https://payzone.store
APP_URL=http://localhost:5173
ACCESS_TOKEN_SECRET=change_me
REFRESH_TOKEN_SECRET=change_me
MONGO_URI=mongodb://localhost:27017/payzone
REDIS_URL=redis://localhost:6379

# Admin access
ADMIN_EMAILS=admin@example.com,owner@example.com

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Resend Email Service
RESEND_API_KEY=re_123456789
# Optional: The email address that will appear in the "From" field.
# Must be a verified domain in Resend. If not set, it defaults to onboarding@resend.dev
EMAIL_FROM=Payzone <no-reply@payzone.store>

# Other services
SERVICE_REQUEST_EMAIL=you@example.com

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PayPal
PAYPAL_CLIENT_ID=change_me
PAYPAL_CLIENT_SECRET=change_me
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
# PayPal subscription plans (set from PayPal dashboard)
PAYPAL_PLAN_BASIC=plan_basic_id
PAYPAL_PLAN_PLUS=plan_plus_id
PAYPAL_PLAN_PRO=plan_pro_id
